{
  "name": "usekits",
  "version": "1.0.1",
  "description": "适合个人开发者的命令行工具，提供插件机制来定制属于个人 CLI 命令",
  "repository": "git@github.com:dun-cat/usekits.git",
  "author": "lumin <527724143@qq.com>",
  "license": "MIT",
  "scripts": {
    "clean": "pnpm --filter './packages/*' clean",
    "dev": "pnpm --parallel --filter './packages/*' run dev",
    "use": "pnpm --filter=cli use",
    "build": "pnpm --filter './packages/*' build",
    "pub": "pnpm --filter './packages/*' publish --access=public"
  }
}