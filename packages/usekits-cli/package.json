{
  "name": "@usekits/cli",
  "version": "1.0.8",
  "homepage": "https://github.com/dun-cat/usekits#readme",
  "description": "适合个人开发者的命令行工具，提供插件机制来定制属于个人 CLI 命令",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "use": "./dist/bin/command.js"
  },
  "files": [
    "dist",
    "READEME.md",
    "!dist/rollup.config.d.ts",
    "!dist/tsconfig.tsbuildinfo",
    "!dist/scripts"
  ],
  "repository": "git@github.com:dun-cat/usekits.git",
  "author": "lumin <527724143@qq.com>",
  "license": "MIT",
  "scripts": {
    "dev": "NODE_ENV=development rollup --bundleConfigAsCjs --config rollup.config.ts --configPlugin typescript -w",
    "build": "rollup --bundleConfigAsCjs --config rollup.config.ts --configPlugin typescript",
    "i": "npm install . -g",
    "lint": "eslint --fix src/**/*.js bin/*",
    "use": "chmod +x ./dist/bin/command.js && ./dist/bin/command.js",
    "pub": "npm publish --access=public",
    "av": "npm --no-git-tag-version version patch"
  },
  "devDependencies": {
    "@commitlint/cli": "^7.5.2",
    "@commitlint/config-conventional": "^7.5.0",
    "@rollup/plugin-commonjs": "^24.0.1",
    "@rollup/plugin-json": "^6.0.0",
    "@rollup/plugin-multi-entry": "^6.0.0",
    "@rollup/plugin-node-resolve": "^15.0.1",
    "@rollup/plugin-typescript": "^11.0.0",
    "@types/fs-extra": "^11.0.1",
    "@types/node": "^18.15.11",
    "eslint": "^5.15.2",
    "eslint-config-airbnb": "^17.1.0",
    "eslint-plugin-jsx-a11y": "^6.2.1",
    "husky": "^1.3.1",
    "jscpd": "^2.0.15",
    "lint-staged": "^8.1.5",
    "rollup": "^3.20.2",
    "rollup-plugin-add-shebang": "^0.3.1",
    "rollup-plugin-cleanup": "^3.2.1",
    "rollup-plugin-copy": "^3.4.0",
    "rollup-plugin-define": "^1.0.1",
    "rollup-plugin-terser": "^7.0.2",
    "tslib": "^2.5.0",
    "typescript": "^5.0.3",
    "validate-commit-msg": "^2.14.0"
  },
  "dependencies": {
    "axios": "^0.19.0",
    "bytes": "^3.1.2",
    "chalk": "^2.4.2",
    "cli-progress": "^3.12.0",
    "cli-table3": "^0.6.3",
    "commander": "^10.0.0",
    "download": "^7.1.0",
    "download-git-repo": "^2.0.0",
    "eslint-plugin-import": "^2.18.0",
    "eslint-plugin-react": "^7.14.2",
    "execa": "^7.1.1",
    "fs-extra": "^11.1.1",
    "fuzzy": "^0.1.3",
    "inquirer": "6.1.0",
    "inquirer-autocomplete-prompt": "^1.0.1",
    "inquirer-checkbox-plus-prompt": "^1.4.2",
    "inquirer-fuzzy-path": "^2.0.3",
    "lodash.merge": "^4.6.1",
    "open": "^6.4.0",
    "ora": "^3.4.0",
    "pnpm": "^8.1.1",
    "progress": "^2.0.3",
    "readline": "^1.3.0",
    "require-dir": "^1.2.0",
    "rimraf": "^2.6.3",
    "semver": "^7.3.8",
    "shelljs": "^0.8.3",
    "tar": "^6.1.13"
  }
}